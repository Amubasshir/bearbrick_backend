generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                BigInt    @id @default(autoincrement())
  name              String
  email             String    @unique
  password          String
  email_verified_at DateTime?
  isAdmin           Boolean   @default(false) @map("is_admin")
  timezone          String    @default("UTC")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // M3d cosmetic equip-slot FKs. Nullable; ownership validated in app code.
  primaryCallingCardId BigInt? @map("primary_calling_card_id")
  equippedBadgeSlot1   BigInt? @map("equipped_badge_slot_1")
  equippedBadgeSlot2   BigInt? @map("equipped_badge_slot_2")
  equippedBadgeSlot3   BigInt? @map("equipped_badge_slot_3")

  voteIntents        VoteIntent[]
  voteEvents         VoteEvent[]
  xpEvents           XpEvent[]
  userBrickCredits   UserBrickVoteCredit[]
  identityState      UserIdentityState?
  trustState         UserTrustState?
  trustScoreEvents   TrustScoreEvent[]
  brickProgress      UserBrickProgress[]
  contextSessions    ContextSession[]
  valueDrivers       BrickValueDriver[]
  progressState      UserProgressState?
  levelUpEvents      LevelUpEvent[]
  xpIdempotencyKeys  XpIdempotencyKey[]
  xpAdjustmentEvents XpAdjustmentEvent[]
  dailyXpCounters    UserDailyXpCounter[]

  // M3d back-relations
  leaderboardStateRows    LeaderboardState[]
  leaderboardRewardEvents LeaderboardRewardEvent[]
  userRewards             UserReward[]
  inboxEntries            InboxEntry[]
}

enum VoteType {
  UNDER
  FAIR
  OVER
}

enum IntentStatus {
  PENDING
  PROCESSED
  REJECTED
}

enum XpReason {
  VOTE
  STREAK
  RECHECK
  ACCURACY
  DEX_STAGE1
  DEX_STAGE3
  DEX_STREAK
}

enum TrustTier {
  UNTRUSTED
  PROBATION
  NEUTRAL
  RELIABLE
  PROVEN
}

enum CycleOutcome {
  UP
  DOWN
  FLAT
}

enum TrustWorkerJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model VoteIntent {
  id           BigInt       @id @default(autoincrement())
  userId       BigInt
  brickId      String       @map("brick_id")
  voteType     VoteType     @map("vote_type")
  status       IntentStatus @default(PENDING) @map("status")
  ipHash       String?      @map("ip_hash")
  userAgent    String?      @map("user_agent")
  sessionId    String?      @map("session_id")
  processedAt  DateTime?    @map("processed_at")
  rejectReason String?      @map("reject_reason")
  voteEventId  BigInt?      @unique @map("vote_event_id")
  createdAt    DateTime     @default(now()) @updatedAt

  user         User       @relation(fields: [userId], references: [id])
  voteEvent    VoteEvent? @relation("IntentToEvent", fields: [voteEventId], references: [id])
  createdEvent VoteEvent? @relation("EventToIntent")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("vote_intents")
}

model VoteEvent {
  id               BigInt   @id @default(autoincrement())
  userId           BigInt   @map("user_id")
  brickId          String   @map("brick_id")
  voteType         VoteType @map("vote_type")
  livePriceAtVote  Decimal  @map("live_price_at_vote") @db.Decimal(12, 2)
  fairRangeLower   Decimal  @map("fair_range_lower") @db.Decimal(12, 2)
  fairRangeUpper   Decimal  @map("fair_range_upper") @db.Decimal(12, 2)
  baseStepAtVote   Int      @map("base_step_at_vote")
  userWeightAtVote Float    @map("user_weight_at_vote")
  cycleId          String   @map("cycle_id")
  ipHash           String?  @map("ip_hash")
  userAgent        String?  @map("user_agent")
  sessionId        String?  @map("session_id")
  voteIntentId     BigInt?  @unique @map("vote_intent_id")
  createdAt        DateTime @default(now()) @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  voteIntent      VoteIntent?      @relation("EventToIntent", fields: [voteIntentId], references: [id])
  createdByIntent VoteIntent?      @relation("IntentToEvent")
  xpEvents        XpEvent[]
  trustScoreEvent TrustScoreEvent?

  @@index([brickId, createdAt])
  @@index([brickId, cycleId])
  @@index([userId, brickId, createdAt])
  @@map("vote_events")
}

model XpEvent {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  voteEventId    BigInt?  @map("vote_event_id")
  brickId        String?  @map("brick_id")
  xpAmount       Int      @map("xp_amount")
  xpDeltaSigned  Int      @default(0) @map("xp_delta_signed")
  reason         XpReason
  eventType      String   @default("legacy") @map("event_type")
  sourceSystem   String   @default("phase2") @map("source_system")
  xpConfirmed    Boolean  @default(true) @map("xp_confirmed")
  localDayKey    DateTime @default(dbgenerated("CURRENT_DATE")) @map("local_day_key") @db.Date
  idempotencyKey String?  @map("idempotency_key")
  metadata       Json?
  createdAt      DateTime @default(now()) @updatedAt

  user              User                @relation(fields: [userId], references: [id])
  voteEvent         VoteEvent?          @relation(fields: [voteEventId], references: [id])
  levelUpEvents     LevelUpEvent[]
  xpIdempotencyKeys XpIdempotencyKey[]
  xpAdjustments     XpAdjustmentEvent[] @relation("OriginalEvent")

  @@index([userId, createdAt])
  @@map("xp_events")
}

model BrickPriceState {
  brickId                 String    @id @map("brick_id")
  baselinePrice           Decimal?  @map("baseline_price") @db.Decimal(12, 2)
  livePrice               Decimal   @map("live_price") @db.Decimal(12, 2)
  currentCycleId          String    @map("current_cycle_id")
  weightedUnder           Float     @default(0) @map("weighted_under")
  weightedFair            Float     @default(0) @map("weighted_fair")
  weightedOver            Float     @default(0) @map("weighted_over")
  weightedTotal           Float     @default(0) @map("weighted_total")
  weightedSinceLastMove   Float     @default(0) @map("weighted_since_last_move")
  pUnder                  Float     @default(0) @map("p_under")
  pFair                   Float     @default(0) @map("p_fair")
  pOver                   Float     @default(0) @map("p_over")
  pricingConfidenceC      Float     @default(0) @map("pricing_confidence_c")
  reliabilityScoreR       Float?    @map("reliability_score_r")
  momentumScore           Int       @default(0) @map("momentum_score")
  lastPriceUpdate         DateTime  @default(now()) @map("last_price_update")
  lastHighConfidencePrice Decimal?  @map("last_high_confidence_price") @db.Decimal(12, 2)
  lastHighConfidenceVotes Float?    @map("last_high_confidence_votes")
  lastConfidenceTimestamp DateTime? @map("last_confidence_timestamp")
  needsRecheck            Boolean   @default(false) @map("needs_recheck")
  freezeMode              Boolean   @default(false) @map("freeze_mode")
  freezeUntil             DateTime? @map("freeze_until")
  cycleStartedAt          DateTime  @default(now()) @map("cycle_started_at")
  cycleStartPrice         Decimal   @map("cycle_start_price") @db.Decimal(12, 2)
  recheckState            String    @default("NONE") @map("recheck_state")
  recheckReason           String?   @map("recheck_reason")
  recheckStartedAt        DateTime? @map("recheck_started_at")
  recheckExpiresAt        DateTime? @map("recheck_expires_at")
  createdAt               DateTime  @default(now()) @updatedAt

  cycleCloseEvents   PricingCycleCloseEvent[]
  freezeWindowEvents BrickFreezeWindowEvent[]

  @@map("brick_price_state")
}

model BrickPriceHistory {
  id           BigInt   @id @default(autoincrement())
  brickId      String   @map("brick_id")
  date         DateTime @db.Date
  closePrice   Decimal  @map("close_price") @db.Decimal(12, 2)
  votesThatDay Int      @default(0) @map("votes_that_day")
  createdAt    DateTime @default(now()) @updatedAt

  @@unique([brickId, date])
  @@index([brickId, date])
  @@map("brick_price_history")
}

model UserBrickVoteCredit {
  userId                      BigInt    @map("user_id")
  brickId                     String    @map("brick_id")
  creditsRemaining            Int       @default(3) @map("credits_remaining")
  lastVotePrice               Decimal?  @map("last_vote_price") @db.Decimal(12, 2)
  lastVoteCycleId             String?   @map("last_vote_cycle_id")
  lastVoteAt                  DateTime? @map("last_vote_at")
  lastCreditRegainPrice       Decimal?  @map("last_credit_regain_price") @db.Decimal(12, 2)
  lastCreditRegainAt          DateTime? @map("last_credit_regain_at")
  lastRecheckCreditGrantCycle String?   @map("last_recheck_credit_grant_cycle")
  lastRecheckCreditGrantAt    DateTime? @map("last_recheck_credit_grant_at")
  createdAt                   DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@id([userId, brickId])
  @@index([brickId])
  @@map("user_brick_vote_credits")
}

model UserIdentityState {
  userId           BigInt    @id @map("user_id")
  emailVerified    Boolean   @default(false) @map("email_verified")
  trustTier        Int       @default(0) @map("trust_tier")
  behaviorState    String    @default("NORMAL") @map("behavior_state")
  streakDays       Int       @default(0) @map("streak_days")
  lastActivityDate DateTime? @map("last_activity_date") @db.Date
  createdAt        DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("user_identity_state")
}

model WorkerCursor {
  workerName      String   @id @map("worker_name")
  lastProcessedId BigInt   @default(0) @map("last_processed_id")
  updatedAt       DateTime @default(now()) @updatedAt

  @@map("worker_cursors")
}

model PricingCycleCloseEvent {
  id                   BigInt       @id @default(autoincrement())
  brickId              String       @map("brick_id")
  cycleId              String       @map("cycle_id")
  closedAt             DateTime     @map("closed_at")
  cycleStartPrice      Decimal      @map("cycle_start_price") @db.Decimal(12, 2)
  cycleEndPrice        Decimal      @map("cycle_end_price") @db.Decimal(12, 2)
  outcome              CycleOutcome
  uniqueVoters         Int          @map("unique_voters")
  weightedTotalAtClose Float        @map("weighted_total_at_close")
  createdAt            DateTime     @default(now()) @map("created_at")

  brickPriceState  BrickPriceState   @relation(fields: [brickId], references: [brickId])
  trustWorkerJobs  TrustWorkerJob[]
  trustScoreEvents TrustScoreEvent[]

  @@unique([brickId, cycleId])
  @@index([cycleId])
  @@index([closedAt])
  @@map("pricing_cycle_close_events")
}

model BrickFreezeWindowEvent {
  id                 BigInt    @id @default(autoincrement())
  brickId            String    @map("brick_id")
  cycleId            String    @map("cycle_id")
  freezeEnteredAt    DateTime  @map("freeze_entered_at")
  freezeExitedAt     DateTime? @map("freeze_exited_at")
  entryWeightedTotal Float     @map("entry_weighted_total")
  exitReason         String?   @map("exit_reason")
  createdAt          DateTime  @default(now()) @map("created_at")

  brickPriceState BrickPriceState @relation(fields: [brickId], references: [brickId])

  @@index([brickId, freezeEnteredAt, freezeExitedAt])
  @@map("brick_freeze_window_events")
}

model UserTrustState {
  userId           BigInt    @id @map("user_id")
  trustScore       Float     @default(0.0) @map("trust_score")
  trustTier        TrustTier @default(UNTRUSTED) @map("trust_tier")
  totalScoredVotes Int       @default(0) @map("total_scored_votes")
  alignedVotes     Int       @default(0) @map("aligned_votes")
  misalignedVotes  Int       @default(0) @map("misaligned_votes")
  abuseFlagCount   Int       @default(0) @map("abuse_flag_count")
  cooldownUntil    DateTime? @map("cooldown_until")
  lastScoredAt     DateTime? @map("last_scored_at")
  lastUpdatedAt    DateTime  @default(now()) @updatedAt @map("last_updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([trustTier])
  @@index([cooldownUntil])
  @@map("user_trust_state")
}

model TrustScoreEvent {
  id                BigInt   @id @default(autoincrement())
  userId            BigInt   @map("user_id")
  brickId           String   @map("brick_id")
  cycleId           String   @map("cycle_id")
  cycleCloseEventId BigInt   @map("cycle_close_event_id")
  voteEventId       BigInt   @unique @map("vote_event_id")
  voteType          VoteType @map("vote_type")
  aligned           Boolean  @map("aligned")
  userWeightAtVote  Float    @map("user_weight_at_vote")
  voteCreatedAt     DateTime @map("vote_created_at")
  createdAt         DateTime @default(now()) @map("created_at")

  user            User                   @relation(fields: [userId], references: [id])
  cycleCloseEvent PricingCycleCloseEvent @relation(fields: [cycleCloseEventId], references: [id])
  voteEvent       VoteEvent?             @relation(fields: [voteEventId], references: [id])

  @@unique([userId, brickId, cycleId])
  @@index([userId, createdAt])
  @@index([cycleId])
  @@map("trust_score_events")
}

model TrustWorkerJob {
  id                BigInt               @id @default(autoincrement())
  cycleCloseEventId BigInt               @unique @map("cycle_close_event_id")
  status            TrustWorkerJobStatus @default(PENDING)
  claimedBy         String?              @map("claimed_by")
  claimedAt         DateTime?            @map("claimed_at")
  startedAt         DateTime?            @map("started_at")
  finishedAt        DateTime?            @map("finished_at")
  errorMessage      String?              @map("error_message")
  createdAt         DateTime             @default(now()) @map("created_at")

  cycleCloseEvent PricingCycleCloseEvent @relation(fields: [cycleCloseEventId], references: [id])

  @@index([status, createdAt])
  @@map("trust_worker_jobs")
}

// ── Dex Phase 1 ────────────────────────────────────────────────────────────────

enum BrickStatus {
  UNRELEASED
  PROTOTYPE
  PUBLISHED
}

model BrickFamily {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  coverImageUrl String?  @map("cover_image_url")
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  bricks Brick[]

  @@map("brick_families")
}

model Brick {
  id               String      @id @default(uuid())
  name             String
  descriptionShort String      @map("description_short")
  descriptionLong  String?     @map("description_long")
  series           String?
  colorway         String?
  imageUrl         String?     @map("image_url")
  thumbnailUrl     String?     @map("thumbnail_url")
  editionSize      Int?        @map("edition_size")
  retailPrice      Decimal?    @map("retail_price") @db.Decimal(12, 2)
  featured         Boolean     @default(false)
  tags             String[]    @default([])
  status           BrickStatus @default(UNRELEASED)
  releasedAt       DateTime?   @map("released_at")
  familyId         String?     @map("family_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  family          BrickFamily?        @relation(fields: [familyId], references: [id])
  userProgress    UserBrickProgress[]
  contextSessions ContextSession[]
  valueDrivers    BrickValueDriver[]

  @@map("bricks")
}

model UserBrickProgress {
  userId      BigInt    @map("user_id")
  brickId     String    @map("brick_id")
  stage       Int       @default(0)
  stage1At    DateTime? @map("stage1_at")
  stage2At    DateTime? @map("stage2_at")
  stage3At    DateTime? @map("stage3_at")
  voteType    String?   @map("vote_type")
  voteEventId BigInt?   @map("vote_event_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id])
  brick Brick @relation(fields: [brickId], references: [id])

  @@id([userId, brickId])
  @@index([userId, stage])
  @@index([brickId, stage])
  @@map("user_brick_progress")
}

model ContextSession {
  id              BigInt   @id @default(autoincrement())
  userId          BigInt   @map("user_id")
  brickId         String   @map("brick_id")
  dwellSeconds    Int      @default(0) @map("dwell_seconds")
  scrollPct       Int      @default(0) @map("scroll_pct")
  interactionSeen Boolean  @default(false) @map("interaction_seen")
  completed       Boolean  @default(false)
  idempotencyKey  String?  @unique @map("idempotency_key")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id])
  brick Brick @relation(fields: [brickId], references: [id])

  @@index([userId, brickId])
  @@map("context_sessions")
}

model BrickValueDriver {
  userId         BigInt   @map("user_id")
  brickId        String   @map("brick_id")
  axis           String
  optionKey      String   @map("option_key")
  idempotencyKey String?  @unique @map("idempotency_key")
  submittedAt    DateTime @default(now()) @map("submitted_at")

  user  User  @relation(fields: [userId], references: [id])
  brick Brick @relation(fields: [brickId], references: [id])

  @@id([userId, brickId])
  @@map("brick_value_drivers")
}

model IdempotencyKey {
  key          String   @id
  userId       BigInt   @map("user_id")
  endpoint     String
  responseCode Int      @map("response_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ── Dex Phase 2 ────────────────────────────────────────────────────────────────

model BrickValueDriverOption {
  id           Int    @id @default(autoincrement())
  axis         String
  optionKey    String @map("option_key")
  label        String
  displayOrder Int    @default(0) @map("display_order")

  @@unique([axis, optionKey])
  @@map("brick_value_driver_options")
}

model DexEventLog {
  id        BigInt   @id @default(autoincrement())
  eventType String   @map("event_type")
  userId    BigInt   @map("user_id")
  brickId   String   @map("brick_id")
  fromStage Int?     @map("from_stage")
  toStage   Int?     @map("to_stage")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([brickId, createdAt])
  @@index([userId, createdAt])
  @@map("dex_event_log")
}

// ── M3a — Core XP Foundation ───────────────────────────────────────────────────

model LevelDefinition {
  id          BigInt   @id @default(autoincrement())
  levelNumber Int      @unique @map("level_number")
  minXp       Int      @map("min_xp")
  label       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("level_definitions")
}

model XpAdjustmentEvent {
  id                BigInt   @id @default(autoincrement())
  userId            BigInt   @map("user_id")
  originalXpEventId BigInt?  @map("original_xp_event_id")
  xpDeltaSigned     Int      @map("xp_delta_signed")
  reason            String
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  metadata          Json?

  user          User     @relation(fields: [userId], references: [id])
  originalEvent XpEvent? @relation("OriginalEvent", fields: [originalXpEventId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("xp_adjustment_events")
}

model UserProgressState {
  userId                  BigInt   @id @map("user_id")
  totalXpConfirmed        Int      @default(0) @map("total_xp_confirmed")
  currentLevel            Int      @default(1) @map("current_level")
  highestLevelEver        Int      @default(1) @map("highest_level_ever")
  lastReconciledXpEventId BigInt   @default(0) @map("last_reconciled_xp_event_id")
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_progress_state")
}

model LevelUpEvent {
  id                   BigInt   @id @default(autoincrement())
  userId               BigInt   @map("user_id")
  fromLevel            Int      @map("from_level")
  toLevel              Int      @map("to_level")
  triggeredByXpEventId BigInt?  @map("triggered_by_xp_event_id")
  createdAt            DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id])
  triggerEvent XpEvent? @relation(fields: [triggeredByXpEventId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("level_up_events")
}

model XpIdempotencyKey {
  key       String   @id
  userId    BigInt   @map("user_id")
  xpEventId BigInt?  @map("xp_event_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  xpEvent XpEvent? @relation(fields: [xpEventId], references: [id])

  @@index([userId])
  @@map("xp_idempotency_keys")
}

model UserDailyXpCounter {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  localDayKey DateTime @map("local_day_key") @db.Date
  xpType      String   @map("xp_type")
  xpTotal     Int      @default(0) @map("xp_total")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, localDayKey, xpType])
  @@index([userId, localDayKey])
  @@map("user_daily_xp_counters")
}

model XpConfigVersion {
  id          BigInt    @id @default(autoincrement())
  version     Int       @unique
  config      Json
  isActive    Boolean   @default(false) @map("is_active")
  activatedAt DateTime? @map("activated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("xp_config_versions")
}

// ── M3b — Sessions and Streaks ─────────────────────────────────────────────────

enum SessionKind {
  MORNING
  EVENING
}

model SessionRotationCycle {
  id        String    @id @default(uuid()) @db.Uuid
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  poolSize  Int       @default(0) @map("pool_size")
  createdAt DateTime  @default(now()) @map("created_at")

  sessionSets DailySessionSet[]
  setItems    DailySessionSetItem[]

  @@map("session_rotation_cycles")
}

model DailySessionSet {
  id              String      @id @default(uuid()) @db.Uuid
  localDayKey     DateTime    @map("local_day_key") @db.Date
  kind            SessionKind
  rotationCycleId String      @map("rotation_cycle_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")

  rotationCycle SessionRotationCycle  @relation(fields: [rotationCycleId], references: [id])
  items         DailySessionSetItem[]

  @@unique([localDayKey, kind])
  @@index([rotationCycleId])
  @@map("daily_session_sets")
}

model DailySessionSetItem {
  sessionSetId    String   @map("session_set_id") @db.Uuid
  brickId         String   @map("brick_id")
  slotIndex       Int      @map("slot_index")
  rotationCycleId String   @map("rotation_cycle_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  sessionSet    DailySessionSet      @relation(fields: [sessionSetId], references: [id], onDelete: Cascade)
  rotationCycle SessionRotationCycle @relation(fields: [rotationCycleId], references: [id])

  @@id([sessionSetId, brickId])
  @@unique([rotationCycleId, brickId])
  @@index([sessionSetId, slotIndex])
  @@index([brickId])
  @@map("daily_session_set_items")
}

model UserSessionProgress {
  userId       BigInt    @map("user_id")
  sessionSetId String    @map("session_set_id") @db.Uuid
  partialCount Int       @default(0) @map("partial_count")
  targetCount  Int       @map("target_count")
  completedAt  DateTime? @map("completed_at")
  expiredAt    DateTime? @map("expired_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@id([userId, sessionSetId])
  @@index([sessionSetId])
  @@map("user_session_progress")
}

model UserSessionBrickCount {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @map("user_id")
  sessionSetId String   @map("session_set_id") @db.Uuid
  brickId      String   @map("brick_id")
  voteEventId  BigInt?  @map("vote_event_id")
  countedAt    DateTime @default(now()) @map("counted_at")

  @@unique([userId, sessionSetId, brickId])
  @@index([userId, sessionSetId])
  @@map("user_session_brick_counts")
}

model UserStreakState {
  userId                       BigInt    @id @map("user_id")
  morningStreak                Int       @default(0) @map("morning_streak")
  morningLastCompletedLocalDay DateTime? @map("morning_last_completed_local_day") @db.Date
  morningLongest               Int       @default(0) @map("morning_longest")
  eveningStreak                Int       @default(0) @map("evening_streak")
  eveningLastCompletedLocalDay DateTime? @map("evening_last_completed_local_day") @db.Date
  eveningLongest               Int       @default(0) @map("evening_longest")
  updatedAt                    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("user_streak_state")
}

model ActiveVote {
  userId             BigInt   @map("user_id")
  brickId            String   @map("brick_id")
  currentVoteType    VoteType @map("current_vote_type")
  currentVoteEventId BigInt   @map("current_vote_event_id")
  voteCountForBrick  Int      @default(1) @map("vote_count_for_brick")
  firstVotedAt       DateTime @map("first_voted_at")
  lastVotedAt        DateTime @map("last_voted_at")

  @@id([userId, brickId])
  @@index([brickId])
  @@map("active_votes")
}

model SessionCompletionEvent {
  id                     BigInt      @id @default(autoincrement())
  userId                 BigInt      @map("user_id")
  sessionSetId           String      @map("session_set_id") @db.Uuid
  kind                   SessionKind
  localDayKey            DateTime    @map("local_day_key") @db.Date
  streakAfterCompletion  Int         @map("streak_after_completion")
  triggeredByVoteEventId BigInt      @map("triggered_by_vote_event_id")
  createdAt              DateTime    @default(now()) @map("created_at")

  @@unique([userId, sessionSetId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([localDayKey, kind])
  @@map("session_completion_events")
}

model SessionWindowExpiryEvent {
  id                   BigInt      @id @default(autoincrement())
  userId               BigInt      @map("user_id")
  sessionSetId         String      @map("session_set_id") @db.Uuid
  kind                 SessionKind
  localDayKey          DateTime    @map("local_day_key") @db.Date
  partialCountAtExpiry Int         @map("partial_count_at_expiry")
  createdAt            DateTime    @default(now()) @map("created_at")

  @@unique([userId, sessionSetId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("session_window_expiry_events")
}

model StreakBreakEvent {
  id          BigInt      @id @default(autoincrement())
  userId      BigInt      @map("user_id")
  kind        SessionKind
  fromStreak  Int         @map("from_streak")
  localDayKey DateTime    @map("local_day_key") @db.Date
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("streak_break_events")
}

// ---------------------------------------------------------------------------
// M3c — Challenge Engine
// ---------------------------------------------------------------------------

enum ChallengeFamily {
  vote
  explore
  maintain
  contribute
  category_mastery
}

enum ChallengeScope {
  daily
  weekly
}

enum DailySlotType {
  vote_1
  vote_2
  explore
  maintain
  category_mastery
  contribute
  wildcard
}

enum WeeklySlotType {
  maintenance
  exploration
  wildcard
}

enum AssignmentStatus {
  assigned
  completed
  expired
}

model ChallengeTemplate {
  id                         BigInt          @id @default(autoincrement())
  code                       String          @unique @db.VarChar(120)
  displayTitle               String          @map("display_title")
  descriptionTemplate        String          @map("description_template")
  challengeFamily            ChallengeFamily @map("challenge_family")
  scope                      ChallengeScope
  difficultyBandMin          Int             @default(1) @map("difficulty_band_min")
  difficultyBandMax          Int             @default(99) @map("difficulty_band_max")
  eligibleLifecycleStates    String[]        @map("eligible_lifecycle_states")
  requiresContributionAccess Boolean         @default(false) @map("requires_contribution_access")
  requiresStaleTargets       Boolean         @default(false) @map("requires_stale_targets")
  requiresCategoryTarget     Boolean         @default(false) @map("requires_category_target")
  requiresSessionTarget      Boolean         @default(false) @map("requires_session_target")
  isActive                   Boolean         @default(true) @map("is_active")
  logicDefinition            Json            @map("logic_definition")
  rewardXpBase               Int             @map("reward_xp_base")
  rewardXpBonus              Int             @default(0) @map("reward_xp_bonus")
  targetCount                Int             @map("target_count")
  timeWindow                 Json?           @map("time_window")
  logicVersion               String          @default("m3c_v1") @map("logic_version") @db.VarChar(32)
  createdAt                  DateTime        @default(now()) @map("created_at")
  updatedAt                  DateTime        @default(now()) @updatedAt @map("updated_at")

  dailyPoolEntries ChallengeDailyPool[]
  userAssignments  UserChallengeAssignment[]

  @@index([challengeFamily, isActive])
  @@index([scope, isActive])
  @@map("challenge_templates")
}

model ChallengeDailyPool {
  id              BigInt          @id @default(autoincrement())
  challengeDate   DateTime        @map("challenge_date") @db.Date
  templateId      BigInt          @map("template_id")
  family          ChallengeFamily
  slotType        DailySlotType   @map("slot_type")
  position        Int
  generatedReason String?         @map("generated_reason")
  createdAt       DateTime        @default(now()) @map("created_at")

  template ChallengeTemplate @relation(fields: [templateId], references: [id])

  @@unique([challengeDate, slotType])
  @@index([challengeDate])
  @@index([templateId])
  @@map("challenge_daily_pool")
}

model UserChallengeAssignment {
  id                   BigInt           @id @default(autoincrement())
  userId               BigInt           @map("user_id")
  templateId           BigInt           @map("template_id")
  scope                ChallengeScope
  assignmentDate       DateTime?        @map("assignment_date") @db.Date
  assignmentWeekKey    DateTime?        @map("assignment_week_key") @db.Date
  weeklySlotType       WeeklySlotType?  @map("weekly_slot_type")
  status               AssignmentStatus @default(assigned)
  targetCount          Int              @map("target_count")
  progressCount        Int              @default(0) @map("progress_count")
  isOverlapWithSession Boolean          @default(false) @map("is_overlap_with_session")
  eligibilitySnapshot  Json             @map("eligibility_snapshot")
  assignedAt           DateTime         @default(now()) @map("assigned_at")
  completedAt          DateTime?        @map("completed_at")
  expiresAt            DateTime         @map("expires_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at")

  template         ChallengeTemplate          @relation(fields: [templateId], references: [id])
  completionEvents ChallengeCompletionEvent[]

  @@index([userId, assignmentDate])
  @@index([userId, status, scope])
  @@index([userId, assignmentWeekKey])
  @@map("user_challenge_assignments")
}

model ChallengeCompletionEvent {
  id                    BigInt         @id @default(autoincrement())
  userId                BigInt         @map("user_id")
  challengeAssignmentId BigInt         @map("challenge_assignment_id")
  scope                 ChallengeScope
  completedAt           DateTime       @default(now()) @map("completed_at")
  xpAwarded             Int            @map("xp_awarded")
  idempotencyKey        String         @unique @map("idempotency_key") @db.VarChar(255)
  createdAt             DateTime       @default(now()) @map("created_at")

  assignment UserChallengeAssignment @relation(fields: [challengeAssignmentId], references: [id])

  @@index([userId, completedAt(sort: Desc)])
  @@index([challengeAssignmentId])
  @@map("challenge_completion_events")
}

model PerfectDayEvent {
  id                  BigInt   @id @default(autoincrement())
  userId              BigInt   @map("user_id")
  localDate           DateTime @map("local_date") @db.Date
  morningCompleted    Boolean  @map("morning_completed")
  eveningCompleted    Boolean  @map("evening_completed")
  allDailiesCompleted Boolean  @map("all_dailies_completed")
  perfectDayAwarded   Boolean  @default(true) @map("perfect_day_awarded")
  idempotencyKey      String   @unique @map("idempotency_key") @db.VarChar(255)
  createdAt           DateTime @default(now()) @map("created_at")

  @@unique([userId, localDate])
  @@index([userId, createdAt(sort: Desc)])
  @@map("perfect_day_events")
}

model ChallengeAssignmentLog {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  templateId     BigInt   @map("template_id")
  assignmentDate DateTime @map("assignment_date") @db.Date
  decision       String
  reasonDetail   Json?    @map("reason_detail")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, assignmentDate])
  @@map("challenge_assignment_log")
}

// ── M3d — Leaderboards and Rewards ─────────────────────────────────────────────

enum LeaderboardScope {
  lifetime
  weekly
  monthly
}

enum LeaderboardMetricType {
  collector_xp
  approved_contribution_weight
  dex_completion_percent
}

enum LeaderboardTieBreakRule {
  earliest_to_score
}

enum PlacementTier {
  top_1
  top_3
  top_10
}

enum RewardType {
  calling_card
  badge
  flourish
  title
}

enum RewardSource {
  leaderboard
  milestone
  secret
  admin_grant
  migration
}

enum InboxEntryType {
  level_up
  contribution_approved
  contribution_rejected
  daily_completed
  weekly_completed
  perfect_day
  leaderboard_reward
  streak_broken
  system_notice
}

model LeaderboardDefinition {
  id                       BigInt                  @id @default(autoincrement())
  leaderboardKey           String                  @unique @map("leaderboard_key") @db.VarChar(80)
  scope                    LeaderboardScope
  metricType               LeaderboardMetricType   @map("metric_type")
  eligibilityRule          Json                    @default("{}") @map("eligibility_rule")
  tieBreakRule             LeaderboardTieBreakRule @default(earliest_to_score) @map("tie_break_rule")
  rewardEnabled            Boolean                 @default(false) @map("reward_enabled")
  periodDefinition         Json?                   @map("period_definition")
  antiSnipingWindowSeconds Int?                    @map("anti_sniping_window_seconds")
  isActive                 Boolean                 @default(true) @map("is_active")
  logicVersion             String                  @default("m3d_v1") @map("logic_version") @db.VarChar(32)
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([scope, isActive])
  @@map("leaderboard_definitions")
}

model LeaderboardState {
  id                BigInt    @id @default(autoincrement())
  leaderboardKey    String    @map("leaderboard_key") @db.VarChar(80)
  periodKey         String    @map("period_key") @db.VarChar(20)
  userId            BigInt    @map("user_id")
  score             Decimal   @default(0) @db.Decimal(18, 4)
  eligible          Boolean   @default(false)
  rank              Int?
  tieBreakTimestamp DateTime? @map("tie_break_timestamp")
  tieBreakEventId   BigInt?   @map("tie_break_event_id")
  lastUpdatedAt     DateTime  @default(now()) @map("last_updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([leaderboardKey, periodKey, userId])
  @@index([userId, leaderboardKey, periodKey])
  @@map("leaderboard_state")
}

model LeaderboardPeriodFinalization {
  id                 BigInt   @id @default(autoincrement())
  leaderboardKey     String   @map("leaderboard_key") @db.VarChar(80)
  periodKey          String   @map("period_key") @db.VarChar(20)
  finalizedAt        DateTime @default(now()) @map("finalized_at")
  totalEligibleUsers Int      @default(0) @map("total_eligible_users")
  topSnapshot        Json     @map("top_snapshot")
  idempotencyKey     String   @unique @map("idempotency_key") @db.VarChar(255)
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([leaderboardKey, periodKey])
  @@index([leaderboardKey, finalizedAt(sort: Desc)])
  @@map("leaderboard_period_finalizations")
}

model LeaderboardVisibilitySnapshot {
  id              BigInt   @id @default(autoincrement())
  leaderboardKey  String   @map("leaderboard_key") @db.VarChar(80)
  periodKey       String   @map("period_key") @db.VarChar(20)
  snapshotTakenAt DateTime @default(now()) @map("snapshot_taken_at")
  topSnapshot     Json     @map("top_snapshot")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([leaderboardKey, periodKey])
  @@index([leaderboardKey, snapshotTakenAt(sort: Desc)])
  @@map("leaderboard_visibility_snapshots")
}

model LeaderboardReward {
  id             BigInt        @id @default(autoincrement())
  leaderboardKey String        @map("leaderboard_key") @db.VarChar(80)
  periodKey      String        @map("period_key") @db.VarChar(20)
  placementTier  PlacementTier @map("placement_tier")
  rewardBundle   Json          @map("reward_bundle")
  processedAt    DateTime?     @map("processed_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@unique([leaderboardKey, periodKey, placementTier])
  @@index([leaderboardKey, periodKey])
  @@map("leaderboard_rewards")
}

model LeaderboardRewardEvent {
  id                   BigInt        @id @default(autoincrement())
  userId               BigInt        @map("user_id")
  leaderboardKey       String        @map("leaderboard_key") @db.VarChar(80)
  periodKey            String        @map("period_key") @db.VarChar(20)
  placementTier        PlacementTier @map("placement_tier")
  rewardBundleSnapshot Json          @map("reward_bundle_snapshot")
  idempotencyKey       String        @unique @map("idempotency_key") @db.VarChar(255)
  createdAt            DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, leaderboardKey, periodKey, placementTier])
  @@index([userId, createdAt(sort: Desc)])
  @@index([leaderboardKey, periodKey])
  @@map("leaderboard_reward_events")
}

model CallingCard {
  id                    BigInt   @id @default(autoincrement())
  name                  String   @db.VarChar(120)
  slug                  String   @unique @db.VarChar(120)
  rarity                String   @default("common") @db.VarChar(32)
  isHiddenUntilUnlocked Boolean  @default(false) @map("is_hidden_until_unlocked")
  tiered                Boolean  @default(false)
  assetRef              String?  @map("asset_ref")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("calling_cards")
}

model Badge {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(120)
  tiered    Boolean  @default(false)
  assetRef  String?  @map("asset_ref")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("badges")
}

model Flourish {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(120)
  assetRef  String?  @map("asset_ref")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("flourishes")
}

model Title {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("titles")
}

model UserReward {
  id         BigInt       @id @default(autoincrement())
  userId     BigInt       @map("user_id")
  rewardType RewardType   @map("reward_type")
  rewardId   BigInt       @map("reward_id")
  tier       Int?
  sourceType RewardSource @map("source_type")
  sourceId   String?      @map("source_id") @db.VarChar(120)
  unlockedAt DateTime     @default(now()) @map("unlocked_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, rewardType])
  @@index([sourceType, sourceId])
  @@map("user_rewards")
}

model InboxEntry {
  id            BigInt         @id @default(autoincrement())
  userId        BigInt         @map("user_id")
  entryType     InboxEntryType @map("entry_type")
  title         String         @db.VarChar(200)
  body          String?
  referenceType String?        @map("reference_type") @db.VarChar(60)
  referenceId   String?        @map("reference_id") @db.VarChar(120)
  metadata      Json           @default("{}")
  isRead        Boolean        @default(false) @map("is_read")
  createdAt     DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@map("inbox_entries")
}
